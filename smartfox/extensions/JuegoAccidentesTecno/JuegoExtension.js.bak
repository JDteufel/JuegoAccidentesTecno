  var category = getString(params, 'category')
  trace('[JuegoExtension] Limpiar logs - Categoría: ' + (category || 'ALL') + ' | sender=' + getSenderName(sender))

  var response = new SFSObject()
  response.putBool('ok', true)
  response.putUtfString('message', 'Use el cliente para llamar a LogsService.limpiarLogs()')


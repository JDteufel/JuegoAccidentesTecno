function handleLog(params, sender) {
  extensionState.commandsProcessed++
  var type = getString(params, 'type')
  var action = getString(params, 'action')
  trace('[LOG][' + type + '] ' + action + ' | sender=' + getSenderName(sender))

  var response = new SFSObject()
  response.putBool('ok', true)
  response.putUtfString('message', 'Log registrado')

  send('logRecorded', response, [sender])
}

function handleCrearSubSala(params, sender) {
  extensionState.commandsProcessed++

  trace('========================================')
  trace('[JuegoExtension] handleCrearSubSala INVOCADO')
  trace('[JuegoExtension] sender=' + getSenderName(sender))
  trace('========================================')

  try {
    var nombreSala = getString(params, 'nombreSala')
    var numeroSala = getString(params, 'numeroSala')
    var jugadoresStr = getString(params, 'jugadores')
    var salaMaestra = getString(params, 'salaMaestra')

    trace('[JuegoExtension] nombreSala: ' + nombreSala)
    trace('[JuegoExtension] numeroSala: ' + numeroSala)
    trace('[JuegoExtension] salaMaestra: ' + salaMaestra)
    trace('[JuegoExtension] jugadoresStr: ' + jugadoresStr)

    if (!nombreSala) {
      trace('[JuegoExtension] ERROR: nombreSala vacio')
      var response = new SFSObject()
      response.putBool('ok', false)
      response.putUtfString('message', 'nombreSala es obligatorio')
      send('crearSubSala', response, [sender])
      return
    }

    var jugadores = []
    try {
      jugadores = JSON.parse(jugadoresStr)
      trace('[JuegoExtension] Jugadores parseados: ' + JSON.stringify(jugadores))
    } catch (e) {
      trace('[JuegoExtension] Error parseando jugadores: ' + e)
      jugadores = []
    }

    var api = getApi()
    var zone = getParentZone()

    trace('[JuegoExtension] api: ' + api)
    trace('[JuegoExtension] zone: ' + zone)

    var settings = new CreateRoomSettings()
    settings.setName(nombreSala)
    settings.setMaxUsers(4)
    settings.setGame(true)
    settings.setAutoRemoveMode(2)

    trace('[JuegoExtension] Intentando crear room...')

    var nuevaSala = api.createRoom(zone, settings, null, false, null, true, true)
    trace('[JuegoExtension] Room creada: ' + nuevaSala.getName() + ' (id=' + nuevaSala.getId() + ')')

    var jugadoresMovidos = []
    for (var i = 0; i < jugadores.length; i++) {
      var nombreJugador = jugadores[i]
      trace('[JuegoExtension] Buscando jugador: ' + nombreJugador)
      var usuario = zone.getUserByName(nombreJugador)
      if (usuario) {
        trace('[JuegoExtension] Jugador encontrado, uniendo...')
        api.joinRoom(usuario, nuevaSala)
        jugadoresMovidos.push(nombreJugador)
        trace('[JuegoExtension] Jugador ' + nombreJugador + ' unido a ' + nombreSala)
      } else {
        trace('[JuegoExtension] Jugador NO encontrado: ' + nombreJugador)
      }
    }

    trace('[JuegoExtension] GameMaster id: ' + sender.getId())
    if (sender.getId() !== -1) {
      api.joinRoom(sender, nuevaSala)
      trace('[JuegoExtension] GameMaster unido a ' + nombreSala)
    }

    var response = new SFSObject()
    response.putBool('ok', true)
    response.putUtfString('nombreSala', nombreSala)
    response.putUtfString('numeroSala', numeroSala)
    response.putUtfString('jugadores', JSON.stringify(jugadoresMovidos))
    response.putUtfString('message', 'Sub-sala creada y jugadores movidos')

    send('crearSubSala', response, [sender])
    trace('[JuegoExtension] Respuesta enviada exitosamente')

  } catch (e) {
    trace('[JuegoExtension] EXCEPCION en handleCrearSubSala: ' + e)
    trace('[JuegoExtension] Stack: ' + e.stack)

    var response = new SFSObject()
    response.putBool('ok', false)
    response.putUtfString('message', 'Error creando room: ' + e)

    send('crearSubSala', response, [sender])
  }
}

function getString(params, fieldName) {
  if (!params || !fieldName) return ''

  try {
    var value = params.getUtfString(fieldName)
    if (typeof value === 'string') {
      return value.trim()
    }
  } catch (e) {
    trace('[JuegoExtension] Error leyendo parametro: ' + fieldName)
  }

  return ''
}

function getSenderName(sender) {
  if (!sender) return 'unknown'

  try {
    if (typeof sender.getName === 'function') {
      return sender.getName()
    }
    if (typeof sender.name === 'string' && sender.name.length > 0) {
      return sender.name
    }
  } catch (e) {
    return 'unknown'
  }

  return 'unknown'
}

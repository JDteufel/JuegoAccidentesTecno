var ZONE_NAME = 'JuegoAccidentesTecno'
var extensionState = {
  initializedAt: null,
  commandsProcessed: 0
}

function init() {
  extensionState.initializedAt = new Date().toISOString()
  extensionState.commandsProcessed = 0

  addRequestHandler('ping', handlePing)
  addRequestHandler('createLobby', handleCreateLobby)
  addRequestHandler('joinLobby', handleJoinLobby)
  addRequestHandler('getLobbyState', handleGetLobbyState)
  addRequestHandler('leaveLobby', handleLeaveLobby)
  addRequestHandler('getLogs', handleGetLogs)
  addRequestHandler('clearLogs', handleClearLogs)
  addRequestHandler('log', handleLog)
  addRequestHandler('register', handleRegister)
  addRequestHandler('login', handleLogin)
  addRequestHandler('getAllLobbies', handleGetAllLobbies)
  addRequestHandler('crearSubSala', handleCrearSubSala)

  trace('[JuegoExtension] Inicializada en ' + extensionState.initializedAt)
  trace('[JuegoExtension] Zona: ' + ZONE_NAME)
  trace('[JuegoExtension] NOTE: Lógica centralizada en src/services/')
}

function destroy() {
  trace('[JuegoExtension] Extensión destruida')
}

function handlePing(params, sender) {
  extensionState.commandsProcessed++
  trace('[JuegoExtension] ping | sender=' + getSenderName(sender))

  var response = new SFSObject()
  response.putBool('ok', true)
  response.putUtfString('zone', ZONE_NAME)
  response.putUtfString('initializedAt', extensionState.initializedAt)
  response.putInt('commandsProcessed', extensionState.commandsProcessed)
  response.putUtfString('note', 'Lógica centralizada en src/services')

  send('pong', response, [sender])
}

function handleRegister(params, sender) {
  extensionState.commandsProcessed++
  var username = getString(params, 'username')
  trace('[JuegoExtension] Registro solicitado: ' + username + ' | sender=' + getSenderName(sender))

  var response = new SFSObject()
  response.putBool('ok', true)
  response.putUtfString('message', 'Use el cliente para llamar a UsuariosService.registrar()')

  send('registerForwarded', response, [sender])
}

function handleLogin(params, sender) {
  extensionState.commandsProcessed++
  var username = getString(params, 'username')
  trace('[JuegoExtension] Login solicitado: ' + username + ' | sender=' + getSenderName(sender))

  var response = new SFSObject()

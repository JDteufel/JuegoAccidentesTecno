' CONTROLLER LAYER
' ============================================
package "src/controller/" #LightGreen {

    class ControladorEstadoApp {
        - estadoApp: EstadoApp
        - vistas: Object
        - controladorPartida: ControladorVistaPartida
        - controladorPartidaPrueba: ControladorVistaPartidaPrueba
        - controladorEncuesta: ControladorVistaEncuesta
        - perfilesAsignados: Perfil[]
        + actualizarVista()
        + irAPantalla(pantalla)
        + aplicarTemaActual()
        + cerrarSesion()
        + actualizarVistaGestion()
        + regresarPantallaAnterior()
        + ocultarVistasPrimarias()
        + obtenerPerfilesAsignados(): Perfil[]
        + agregarPerfilAsignado(perfil)
        + reiniciarPerfilesAsignados()
    }

    class ControladorVistaInicial {
        - vistaInicial: VistaInicial
        - controladorEstadoApp: ControladorEstadoApp
        + init()
    }

    class ControladorVistaPartida {
        - vistaPartida: VistaPartida
        - controladorEstadoApp: ControladorEstadoApp
        - accidentesSeleccionados: Accidente[]
        - perfilAsignado: Perfil
        - cartasMano: Carta[]
        - metricasUsoCartas: Object
        + init()
        + iniciarPartida(nombre)
        + jugarCarta(carta)
        + pasarTurno()
        + finTurno()
        + verificarActivarAccidente()
        + verificarVictoria()
        + obtenerPerfilesUsados(): String[]
        + intercambiarCartas(carta1, carta2)
        + activarActividadGrupal(actividad)
        + desactivarAccidenteMasAntiguo()
        + reiniciarPartida()
        + finalizarPartida()
        + generarResumenDebate(duracion): Object
        + getPerfilAsignado(): Perfil
        + getAccidentesSeleccionados(): Accidente[]
        + getCartasMano(): Carta[]
    }

    class ControladorVistaEncuesta {
        - vistaEncuesta: VistaEncuesta
        - controladorEstadoApp: ControladorEstadoApp
        - username: String
        - lobbyCode: String
        + init()
        + configurarUsuario(username, lobbyCode)
        + enviarEncuesta(respuestas)
        + _calcularPromedio(respuestas): float
        + mostrar()
    }

    class ControladorVistaGestion {
        - vistaGestion: VistaGestion
        - controladorEstadoApp: ControladorEstadoApp
        - estadoApp: EstadoApp
        - estrategiaActual: EstrategiaDistribucion
        + init()
        + actualizarVistaGestion()
        + autoDistribuir()
        + asignarJugadorManual(jugador, sala)
        + iniciarSala(num)
        + iniciarTodasLasSalas()
    }

    abstract class EstrategiaDistribucion {
        + {abstract} ejecutar(jugadores, salas): Object
    }

    class EstrategiaBalanceada
    class EstrategiaSecuencial
    class EstrategiaPersonalizada

    class ControladorVistaCrearJuego
    class ControladorVistaJugar
    class ControladorVistaInicioSesion
    class ControladorVistaRegistro
    class ControladorVistaConfiguracion
    class ControladorVistaAccidentes
    class ControladorVistaCartas
    class ControladorVistaReglas
    class ControladorVistaTutorial
    class ControladorVistaInicialR
    class ControladorVistaPartidaPrueba

    EstrategiaDistribucion <|-- EstrategiaBalanceada
    EstrategiaDistribucion <|-- EstrategiaSecuencial
    EstrategiaDistribucion <|-- EstrategiaPersonalizada

    ControladorEstadoApp "1" *-- "1" EstadoApp : manages
    ControladorEstadoApp "1" o-- "1" ControladorVistaPartida : partida
    ControladorEstadoApp "1" o-- "1" ControladorVistaPartidaPrueba : partidaPrueba
    ControladorEstadoApp "1" o-- "1" ControladorVistaEncuesta : encuesta
    ControladorEstadoApp "1" o-- "*" Perfil : perfilesAsignados
    ControladorVistaGestion "1" *-- "1" EstrategiaDistribucion : usa
    ControladorVistaInicial "1" o-- "1" VistaInicial : vista
    ControladorVistaInicial "1" --> "1" ControladorEstadoApp : estado
    ControladorVistaPartida "1" o-- "1" VistaPartida : vista
    ControladorVistaPartida "1" --> "1" ControladorEstadoApp : estado
    ControladorVistaPartida "1" o-- "*" Accidente : seleccionados
    ControladorVistaPartida "1" o-- "1" Perfil : asignado
    ControladorVistaPartida "1" o-- "*" Carta : mano
    ControladorVistaEncuesta "1" o-- "1" VistaEncuesta : vista
    ControladorVistaEncuesta "1" --> "1" ControladorEstadoApp : estado
    ControladorVistaGestion "1" o-- "1" VistaGestion : vista
    ControladorVistaGestion "1" --> "1" EstadoApp : estado
}

' ============================================
' SERVICES LAYER
' ============================================
package "src/services/" #LightCoral {

    class SmartFoxService {
        <<module>>
        + ensureConnection(username): Promise
        + createLobbyRoom(code, host): Promise
        + joinLobbyRoom(code, name): Promise
        + leaveCurrentRoom(): Promise
        + sendExtensionRequest(cmd, params)
        + subscribeToLobbyUpdates(listener)
        + subscribeToRoomJoin(listener)
        + subscribeToRoomEnter(listener)
        + subscribeToIniciarPartida(listener)
        + subscribeToJugadorSalaAsignada(listener)
        + getCurrentLobbyState(): Object
        + emitLobbyUpdate()
        + getSmartFoxInstance(): SFS2X.SmartFox
        + registerUser(user, pass): Promise
        + loginUser(user, pass): Promise
        + testSmartFoxPing(): Promise
        + updateConfig(cfg)
        + getConfig(): Object
    }

    class MongoDBService {
        - baseUrl: String
        + request(endpoint, data, method): Promise
        + registerUser(user, pass, tema): Promise
        + loginUser(user, pass): Promise
        + actualizarTemaUsuario(user, tema): Promise
        + getUser(user): Promise
        + getAllUsers(): Promise
        + logEvent(type, action, details): Promise
        + logMetric(type, action, details): Promise
        + submitEncuesta(data): Promise
        + getLogs(): Promise
        + clearLogs(): Promise
        + healthCheck(): Promise
        + checkConnection(): Object
    }

    class PartidaService {
        - partidasActivas: Object
        + crearSalaPartida(name, host): Promise
        + unirseASalaPartida(name, player): Promise
        + iniciarPartida(name): Promise
        + onJugadorAsignado(cb)
        + onIniciarPartida(cb)
        + obtenerEstadoPartida(name): Object
        + obtenerPartidaDelJugador(player): Object
        + obtenerTodasLasPartidas(): Object[]
        + asignarJugadorASala(name, player, numSala)
        + removerJugadorDePartida(name, player)
        + cerrarPartida(name)
        + registrarSmartFoxListeners()
    }

    class LobbiesService {
        - lobbiesByCode: Object
        - lobbyCodeBySender: Object
        + crearLobby(host, sender): Object
        + unirseALobby(code, guest, sender): Object
        + salirDelLobby(code, sender): Object
        + obtenerEstadoLobby(code): Object
        + obtenerTodosLosLobbies(): Object
        + obtenerCodigoDelSender(sender): String
    }

    class UsuariosService {
        + inicializar()
        + registrar(user, pass, tema): Promise
        + login(user, pass): Promise
        + actualizarTema(user, tema): Promise
        + obtenerTemaUsuario(user): String
        + obtenerUsuario(user): Object
        + obtenerTodos(): Object[]
        + existe(user): boolean
    }

    class LogsService {
        <<module>>
        + logsLocales: Object
        + initLogsService(sfs)
        + logEvent(type, action, details)
        + syncAllToMongoDB(): Promise
        + exportarJSON(category): String
        + obtenerEstadisticas(): Object
        + limpiarLogs(category)
        + obtenerLogs(category): Object[]
        + obtenerTodosLogs(): Object[]
    }

    class TemaService {
        - temaActual: String
        + obtenerTemaActual(): String
        + cargarTemaInicial(user): Promise
        + cambiarTema(temaId): Promise
        + obtenerColoresTema(temaId): Object
        + onCambioTema(callback)
    }

    PartidaService ..> SmartFoxService : uses
    PartidaService ..> LogsService : logs
    LobbiesService ..> LogsService : logs
    UsuariosService ..> MongoDBService : HTTP
    UsuariosService ..> TemaService : theme
    LogsService ..> MongoDBService : syncs
    LogsService ..> SmartFoxService : envia via SFS
    TemaService ..> UsuariosService : lee tema
}


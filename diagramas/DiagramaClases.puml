@startuml JuegoAccidentesTecno

skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam roundcorner 10
skinparam linetype ortho

left to right direction

title JuegoAccidentesTecno - Diagrama de Clases UML

' ============================================
' MODEL LAYER
' ============================================
package "src/model/" #LightBlue {

    abstract class Carta {
        - titulo: String
        - categorias: String[]
        - codigo: String
        - detalle: String
        - color: String
        - horas: int
        - tipo: String
        - tipoHora: String
        - estado: String
        - degradada: boolean
        + aplicarHoras(perfil): int
        + activar()
        + degradar()
        + deshabilitar()
        + potenciar()
        + estaActiva(): boolean
        + estaDeshabilitada(): boolean
        + getColor(): String
        + obtenerImagen()
        + obtenerDescripcion(): String
        + toJSON(): Object
        + {static} fromJSON(json): Carta
    }

    class CartasHijas {
        34 clases:
        CartaGitHub, CartaNetflix, CartaTwitch,
        CartaYouTube, CartaSpotify, CartaTikTok,
        CartaReddit, CartaDiscord, CartaSlack,
        CartaNotion, CartaFigma, CartaTrello,
        CartaJira, CartaTeams, CartaLinkedIn,
        CartaAWS, CartaDocker, CartaKubernetes,
        CartaVSCode, CartaCoursera, CartaGoogleDrive,
        CartaObsidian, CartaPinterest, CartaTwitter,
        CartaZoom, CartaStrava, CartaSiesta,
        CartaDormirNoche, CartaMeditar, CartaLeer,
        CartaCaminar, CartaFutbol, CartaComodin, CartaDuolingo
    }

    abstract class Accidente {
        - nombre: String
        - codigo: String
        - descripcion: String
        - categoriasAfectadas: String[]
        - categoriasPositivas: String[]
        - nivel: int
        - activo: boolean
        + activar()
        + desactivar()
        + afectaCategoria(cats): boolean
        + beneficiaCategoria(cats): boolean
        + aplicarEfecto(cartas): Object
        + obtenerMensaje(): String
        + obtenerImagen()
        + toJSON(): Object
        + {static} fromJSON(json): Accidente
    }

    class AccidentesHijos {
        16 clases:
        AccidenteAtaqueDDoS, AccidenteAtaqueSeguridad,
        AccidenteCorrupcionDatos, AccidenteCorteEnergia,
        AccidenteExfiltracionDatos, AccidenteFalloActualizacion,
        AccidenteFalloAutenticacion, AccidenteFalloHardware,
        AccidenteFalloNube, AccidenteFalloSoftware,
        AccidenteFugaDatos, AccidenteInterferenciaEM,
        AccidentePhishingMasivo, AccidenteSesgoIA,
        AccidenteSobrecargaRed, AccidenteVulnerabilidadZeroDay
    }

    abstract class Perfil {
        - nombre: String
        - horasPorCategoria: Object
        - categoriasValidas: String[]
        - descripcion: String
        - horasCompletadasPorCategoria: Object
        - completado: boolean
        + horasRequeridas: int
        + horasCompletadas: int
        + agregarHoras(horas, tipoHora)
        + verificarCompletado()
        + getProgreso(): float
        + getProgresoPorCategoria(tipoHora): float
        + cartaEsValida(cats): boolean
        + reset()
        + toJSON(): Object
        + {static} fromJSON(json): Perfil
    }

    class PerfilesHijos {
        18 clases:
        PerfilEstudiante, PerfilDesarrolladorFullStack,
        PerfilIngenieroSoftware, PerfilArquitectoSoluciones,
        PerfilCientificoDatos, PerfilEspecialistaSeguridad,
        PerfilEspecialistaCloud, PerfilEspecialistaRedes,
        PerfilGerenteProyectosTI, PerfilDesarrolladorDevOps,
        PerfilDocente, PerfilFreelancer, PerfilGamer,
        PerfilAdictoRedes, PerfilCommunityManager,
        PerfilAnalistaIA, PerfilAnalistaSistemas,
        PerfilAdminBasesDatos
    }

    abstract class ActividadGrupal {
        - nombre: String
        - codigo: String
        - descripcion: String
        - horasBeneficio: int
        - categoriasBeneficiadas: String[]
        - activa: boolean
        + activar()
        + desactivar()
        + beneficiaCategoria(cats): boolean
        + aplicarBeneficio(cartas, perfil): Carta[]
        + obtenerMensaje(): String
        + toJSON(): Object
        + {static} fromJSON(json): ActividadGrupal
    }

    class ActividadesHijas {
        6 clases:
        ActividadHackathon, ActividadFutbol,
        ActividadPelicula, ActividadYoga,
        ActividadEstudioGrupal, ActividadKaraoke
    }

    class GameMaster {
        - username: String
        - tipo: String
        - fechaRegistro: Date
        - ultimaSesion: Date
        + setUsername(username)
        + getUsername(): String
        + getTipo(): String
        + actualizarUltimaSesion()
        + toJSON(): Object
    }

    class EstadoApp {
        - pantallaActual: String
        - pantallaAnterior: String
        - tipoJugador: String
        - usuario: GameMaster
        - lobbyActual: Object
        - lobbySenderName: String
        - lobbyPlayerName: String
        - salaMaestra: Object
        - jugadoresPool: String[]
        - subSalas: Object[]
        - jugadoresAsignados: Object
        + setPantalla(pantalla)
        + setTipoJugador(tipo)
        + setUsuario(username)
        + getUsuario(): GameMaster
        + getUsername(): String
        + estaLogueado(): boolean
        + cerrarSesion()
        + setLobbyActual(data, sender, player)
        + getLobbyActual(): Object
        + getLobbySenderName(): String
        + getLobbyPlayerName(): String
        + limpiarLobbyActual()
        + setSalaMaestra(data)
        + getSalaMaestra(): Object
        + limpiarSalaMaestra()
        + agregarJugadorPool(nombre)
        + removerJugadorPool(nombre)
        + asignarJugadorASala(nombre, numSala)
        + desasignarJugador(nombre)
        + obtenerJugadoresDeSala(numSala): String[]
        + crearSubSala(num)
        + eliminarSubSala(num)
        + renumerarSubSalas()
        + regresarPantallaAnterior()
    }

    enum constantes {
        CATEGORIAS_CARTA
        CATEGORIAS_ACCIDENTE
        TIPOS_HORA
    }

    enum PANTALLAS {
        INICIAL_PUBLICA
        INICIAL_GAMEMASTER
        REGISTRO
        INICIO_SESION
        UNIRSE_LOBBY
        GESTION_LOBBY
        GESTION
        REGLAS
        CARTAS
        ACCIDENTES
        PARTIDA
        PARTIDA_PRUEBA
        CONFIGURACION
        ENCUESTA
    }

    enum TIPOS_JUGADOR {
        JUGADOR
        GAMEMASTER
        INVITADO
    }

    Carta <.. CartasHijas : 34 extends
    Accidente <.. AccidentesHijos : 16 extends
    Perfil <.. PerfilesHijos : 18 extends
    ActividadGrupal <.. ActividadesHijas : 6 extends

    EstadoApp "1" *-- "1" GameMaster : usuario
    EstadoApp "1" o-- "*" String : jugadoresPool
    EstadoApp "1" o-- "*" Object : jugadoresAsignados
    EstadoApp ..> PANTALLAS : uses
    EstadoApp ..> TIPOS_JUGADOR : uses
    Accidente "1" --> "*" Carta : affects
    ActividadGrupal "1" --> "*" Carta : benefits
    Perfil "1" --> "*" Carta : validates
}

' ============================================
' VIEW LAYER
' ============================================
package "src/view/" #LightYellow {

    abstract class VistaListaBase {
        + containerEl: HTMLElement
        + {abstract} obtenerConfiguracionLista(): Object
        + crear()
        + actualizarItems(items)
        + mostrar()
        + ocultar()
    }

    abstract class VistaFormularioBase {
        + containerEl: HTMLElement
        + {abstract} obtenerConfiguracionFormulario(): Object
        + crear()
        + getValorCampo(nombre): String
        + mostrar()
        + ocultar()
    }

    class VistaInicial {
        + engine: BABYLON.Engine
        + scene: BABYLON.Scene
        + overlayEl: HTMLElement
        + crearEscena()
        + crearMenuDOM()
        + render(targetFps)
    }

    class VistaInicialR {
        + containerEl: HTMLElement
        + crear()
        + mostrar()
        + ocultar()
    }

    class VistaPartida {
        + engine: BABYLON.Engine
        + scene: BABYLON.Scene
        + guiTexture: GUI.AdvancedDynamicTexture
        + crear()
        + crearEscena3D()
        + crearHUD()
        + configurarAccidentes(accidentes)
        + configurarPerfil(perfil)
        + mostrarResumenFinal(resumen, logJSON)
        + mostrarLogCompleto(logJSON)
    }

    class VistaPartidaPrueba {
        + engine: BABYLON.Engine
        + scene: BABYLON.Scene
        + crear()
        + mostrarResumenFinal(resumen, logJSON)
        + mostrarLogCompletoPrueba(logJSON, overlay)
    }

    class VistaEncuesta {
        + containerEl: HTMLElement
        + respuestas: Object
        + preguntaActual: int
        + crear()
        + _renderPregunta(zona, indice)
        + _navegar(direccion)
        + mostrar()
        + ocultar()
        + resetear()
    }

    class VistaGestion {
        + containerEl: HTMLElement
        + crear()
        + actualizarPool(jugadores)
        + actualizarSalas(subSalas, asignados)
    }

    class VistaCrearJuego
    class VistaReglas
    class VistaJugar
    class VistaInicioSesion
    class VistaRegistro
    class VistaConfiguracion
    class VistaCartas
    class VistaAccidentes
    class VistaTutorial

    class GestorAjusteRatio {
        {static} esMovil(): boolean
        {static} esTablet(): boolean
        {static} configurarGUI(gui)
        {static} crearAjustadorElemento(el, cfg)
    }

    VistaListaBase <|-- VistaCrearJuego
    VistaListaBase <|-- VistaReglas
    VistaFormularioBase <|-- VistaJugar
    VistaFormularioBase <|-- VistaInicioSesion
    VistaFormularioBase <|-- VistaRegistro

    VistaInicial ..> GestorAjusteRatio : uses
    VistaPartida ..> GestorAjusteRatio : uses
    VistaEncuesta ..> GestorAjusteRatio : uses
    VistaGestion ..> GestorAjusteRatio : uses
    VistaCartas ..> GestorAjusteRatio : uses
    VistaAccidentes ..> GestorAjusteRatio : uses
    VistaTutorial ..> GestorAjusteRatio : uses
}


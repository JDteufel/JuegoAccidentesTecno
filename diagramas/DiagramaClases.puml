package "smartfox/extensions/" #Lavender {
    class JuegoExtension {
        <<SFS Extension>>
        + init()
        + destroy()
        + handlePing(params, sender)
        + handleRegister(params, sender)
        + handleLogin(params, sender)
        + handleCreateLobby(params, sender)
        + handleJoinLobby(params, sender)
        + handleGetLobbyState(params, sender)
        + handleLeaveLobby(params, sender)
        + handleLog(params, sender)
        + handleGetLogs(params, sender)
        + handleClearLogs(params, sender)
        + handleGetAllLobbies(params, sender)
        + handleCrearSubSala(params, sender)
        + handleIniciarPartida(params, sender)
        + getString(params, key): String
        + getSenderName(sender): String
    }
}

' ============================================
' REST BRIDGE
' ============================================
package "rest-bridge/" #MistyRose {

    class ExpressServer {
        <<Express App>>
        + listen(PORT)
        ---
        GET /health
        POST /api/usuarios/register
        POST /api/usuarios/login
        PATCH /api/usuarios/:user/tema
        GET /api/usuarios
        POST /api/logs
        GET /api/logs
        DELETE /api/logs
        POST /api/Metricas
        GET /api/Metricas
        POST /api/encuestas
        GET /api/encuestas
    }

    class GameMasterModel {
        <<Mongoose>>
        - username: String {unique}
        - password: String
        - tema: String
        - createdAt: Date
        ---
        collection: "Usuarios"
    }

    class LogModel {
        <<Mongoose>>
        - timestamp: Date
        - type: String
        - action: String
        - details: Mixed
        ---
        collection: "Logs"
    }

    class MetricModel {
        <<Mongoose>>
        - timestamp: Date
        - type: String
        - action: String
        - details: Mixed
        ---
        collection: "Metricas"
    }

    class EncuestaModel {
        <<Mongoose>>
        - username: String
        - lobbyCode: String
        - respuestas: Mixed
        - promedioGeneral: Number
        - timestamp: Date
        ---
        collection: "Encuestas"
    }

    class connectDB {
        + connectDB(): Promise
    }

    class gameMastersRoutes {
        <<Router>>
        + POST /register
        + POST /login
        + PATCH /:user/tema
        + GET /
    }

    class logsRoutes {
        <<Router>>
        + POST /
        + GET /
        + DELETE /
    }

    class metricasRoutes {
        <<Router>>
        + POST /
        + GET /
    }

    class encuestasRoutes {
        <<Router>>
        + POST /
        + GET /
    }

    ExpressServer "1" *-- "1" connectDB : init
    ExpressServer "1" --> "4" gameMastersRoutes : "/api/usuarios"
    ExpressServer "1" --> "1" logsRoutes : "/api/logs"
    ExpressServer "1" --> "1" metricasRoutes : "/api/Metricas"
    ExpressServer "1" --> "1" encuestasRoutes : "/api/encuestas"

    gameMastersRoutes "1" --> "*" GameMasterModel : CRUD
    logsRoutes "1" --> "*" LogModel : CRUD
    metricasRoutes "1" --> "*" MetricModel : CRUD
    encuestasRoutes "1" --> "*" EncuestaModel : CRUD
}

' ============================================
' CROSS-LAYER RELATIONSHIPS
' ============================================
ControladorEstadoApp "1" --> "1" TemaService : aplica temas
ControladorEstadoApp "1" --> "1" SmartFoxService : suscribe eventos
ControladorVistaPartida "1" --> "1" LogsService : registra eventos
ControladorVistaEncuesta "1" --> "1" MongoDBService : envia encuesta
ControladorVistaInicioSesion "1" --> "1" UsuariosService : autentica
ControladorVistaRegistro "1" --> "1" UsuariosService : registra
ControladorVistaConfiguracion "1" --> "1" TemaService : cambia tema
ControladorVistaGestion "1" --> "1" SmartFoxService : crea salas
ControladorVistaJugar "1" --> "1" SmartFoxService : une a lobby
VistaPartida "1" --> "*" Accidente : configura
VistaPartida "1" --> "1" Perfil : configura

MongoDBService "1" --> "1" ExpressServer : HTTP fetch
JuegoExtension "1" --> "1" SmartFoxService : reenvia al cliente

@enduml
